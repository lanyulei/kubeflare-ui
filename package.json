{
  "name": "kubeflare",
  "version": "6.0.0",
  "private": true,
  "description": "An out-of-box UI solution for enterprise applications",
  "repository": "git@github.com:kubeflare/kubeflare.git",
  "scripts": {
    "analyze": "cross-env ANALYZE=1 max build && pnpm run strip:sourcemaps",
    "biome:lint": "npx @biomejs/biome lint",
    "build": "max build && pnpm run strip:sourcemaps",
    "deploy": "npm run build && npm run gh-pages",
    "dev": "concurrently -k -n umi,proxy -c blue,green \"npm run dev:umi\" \"npm run dev:proxy\"",
    "dev:umi": "cross-env PORT=9528 REACT_APP_ENV=dev MOCK=none UMI_ENV=dev max dev",
    "dev:proxy": "cross-env DEV_PROXY_PORT=9527 UMI_TARGET=http://127.0.0.1:9528 BACKEND_TARGET=http://127.0.0.1:8000 node scripts/dev-proxy.cjs",
    "gh-pages": "pnpm run strip:sourcemaps && gh-pages -d dist",
    "i18n-remove": "pro i18n-remove --locale=zh-CN --write",
    "postinstall": "max setup",
    "jest": "jest",
    "lint": "npm run biome:lint && npm run tsc",
    "lint-staged": "lint-staged",
    "prepare": "husky",
    "preview": "npm run build && max preview --port 9527",
    "record": "cross-env NODE_ENV=development REACT_APP_ENV=test max record --scene=login",
    "serve": "umi-serve",
    "start": "cross-env PORT=9527 UMI_ENV=dev max dev",
    "start:dev": "cross-env PORT=9527 REACT_APP_ENV=dev MOCK=none UMI_ENV=dev max dev",
    "start:pre": "cross-env REACT_APP_ENV=pre UMI_ENV=dev max dev",
    "start:test": "cross-env REACT_APP_ENV=test MOCK=none UMI_ENV=dev max dev",
    "test": "jest",
    "test:coverage": "npm run jest -- --coverage",
    "test:update": "npm run jest -- -u",
    "strip:sourcemaps": "find dist -type f -name '*.map' -delete",
    "tsc": "tsc --noEmit"
  },
  "browserslist": [
    "defaults"
  ],
  "dependencies": {
    "@ant-design/icons": "^5.6.1",
    "@ant-design/pro-components": "^2.8.10",
    "@ant-design/v5-patch-for-react-19": "^1.0.3",
    "@codemirror/lang-yaml": "^6.1.3",
    "@uiw/react-codemirror": "^4.25.11",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^6.0.0",
    "antd": "^5.29.3",
    "antd-style": "^3.7.1",
    "classnames": "^2.5.1",
    "dayjs": "^1.11.21",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^10.1.0",
    "rehype-sanitize": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@ant-design/pro-cli": "^3.4.0",
    "@biomejs/biome": "^2.5.8",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/express": "^5.0.6",
    "@types/http-proxy": "^1.17.17",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.25",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/react-helmet": "^6.1.11",
    "@umijs/max": "^4.7.5",
    "concurrently": "^9.2.4",
    "cross-env": "^7.0.3",
    "express": "^4.22.2",
    "gh-pages": "^6.3.0",
    "http-proxy": "^1.18.1",
    "husky": "^9.1.7",
    "jest": "^30.4.2",
    "jest-environment-jsdom": "^29.7.0",
    "lint-staged": "^16.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "umi-presets-pro": "^2.0.3",
    "umi-serve": "^1.9.11"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "packageManager": "pnpm@11.20.0+sha512.9a6f330a95b66446ea088faf1521405a8a01f07fde7124cc9958dfed52d4bb436737e65b08f85f37b46fcba375092558ac51262b816844b22f63406ed166bfee"
}
